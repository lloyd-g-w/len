[Desktop Entry]
Type=Application
Version=1.0
Name=Len
GenericName=Handwritten notes
Comment=Handwriting-first notes: paged notebooks, an infinite canvas and self-hosted sync
Exec=len %U
Icon=dev.len.len
Terminal=false
Categories=Office;
Keywords=notes;handwriting;notebook;pen;stylus;drawing;canvas;pdf;
MimeType=application/pdf;image/png;image/jpeg;image/webp;x-scheme-handler/len;
StartupNotify=true
StartupWMClass=dev.len.len
