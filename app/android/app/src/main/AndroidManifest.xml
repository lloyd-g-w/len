<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Runs without a touchscreen too (Samsung DeX, Chromebooks, mouse + pen). -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <!-- Needed for syncing with a Len server. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Audio recording (features/audio): asked for at runtime on the first
         recording. The microphone is optional hardware. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- Recording continues in the background (screen off, another app in
         front) in a foreground service of type "microphone"
         (RecordingService.kt) with a notification (asked for at the first
         recording on Android 13+) and a partial wake lock. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- usesCleartextTraffic: self-hosted sync servers often run over plain
         http on a home LAN (e.g. http://192.168.1.10:8080). Use https for
         anything reachable from the internet. -->
    <application
        android:label="Len"
        android:usesCleartextTraffic="true"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:resizeableActivity="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode|colorMode"
            android:hardwareAccelerated="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Free orientation (no screenOrientation) and free resizing:
                 split screen, pop-up windows and Samsung DeX / desktop
                 windows. Smallest sensible freeform window: -->
            <layout
                android:defaultWidth="1100dp"
                android:defaultHeight="760dp"
                android:minWidth="360dp"
                android:minHeight="400dp"/>
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- "Open with Len" and "Share to Len" for PDFs and images
                 (IncomingFiles.kt). singleTask (above): files opened from
                 another app reach the running Len (onNewIntent) instead of
                 starting a second copy inside that app's task. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
        </activity>
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone"/>
        <!-- Samsung DeX: keep the process alive (no restart) when moving
             between the phone screen and the DeX display / changing density. -->
        <meta-data
            android:name="com.samsung.android.keepalive.density"
            android:value="true" />
        <meta-data
            android:name="com.samsung.android.multidisplay.keep_process_alive"
            android:value="true" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Web links in PDFs open in the browser (url_launcher). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>
