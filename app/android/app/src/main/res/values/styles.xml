<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Shared by both themes: the app draws edge to edge behind transparent
         system bars (the Dart side, ui/system_bars.dart, then keeps the icons
         in step with the app's own light/dark theme). -->
    <style name="LenWindow" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/len_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <!-- Applied while the process starts. Android 12+: the system splash
         screen (surface colour + app icon), kept until Flutter's first frame.
         Older versions: launch_background (the same look). -->
    <style name="LaunchTheme" parent="LenWindow">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/len_window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_icon</item>
    </style>

    <!-- Applied once Flutter runs: the window behind the Flutter UI. -->
    <style name="NormalTheme" parent="LenWindow" />
</resources>
